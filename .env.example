# 复制为 .env 后填写。.env 已被 .gitignore 排除,不要提交。

# --- LLM ---
# DeepSeek API Key(事实抽取、脚本与逐拍版式使用)。留空则平台无法生成脚本。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- ffmpeg ---
# 本机 ffmpeg 不在系统 PATH,默认指向已安装位置;若换机器请修改。
FFMPEG_BIN=C:\ffmpeg\bin
FFMPEG_FONTS_DIR=C:\Windows\Fonts

# --- 生成通道 ---
# 两种后端二选一:
#  - mcode : 经 MiniMax Code 托管的 mcode-tools CLI(只能在 MiniMax Code 里跑)
#  - direct: 用 M Plan 订阅 Key 直连 MiniMax 开放平台,任何终端都能跑
# 留空自动选择:配了 MINIMAX_PLAN_KEY 且找不到 mcode-tools 时走 direct。
CONNECTOR_BACKEND=
# mcode-tools CLI 路径(MiniMax Code 运行时注入)。留空则从 PATH 查找。
MCODE_TOOLS=
# M Plan 订阅 Key(sk-cp-…),在 https://platform.minimax.cn/console/plan 复制。不要提交。
MINIMAX_PLAN_KEY=
MINIMAX_API_HOST=https://api.minimax.cn
# 直连后端用的模型
TTS_MODEL=speech-2.8-hd
MUSIC_MODEL=music-2.6
IMAGE_MODEL=image-01

# --- 配额 ---
# 项目级配额节流上限(等效美元值,仅用于估算与节流,非真实账单)
DEFAULT_QUOTA_BUDGET=40
# 用户套餐到期日(用于设置页提醒)
PLAN_EXPIRES_ON=2026-10-31

# --- 品类 ---
DEFAULT_CATEGORY=auto_long

# --- 素材池 ---
# 视频平台,按优先级。可选 bilibili,youtube,douyin,tiktok(douyin 靠 Bing 站内检索,实测搜不到,默认不开)
# tiktok 主要拉品牌官方号主页(名单在 profiles/auto_long.yaml),国内需要下面的 YTDLP_PROXY
MEDIA_PLATFORMS=bilibili,youtube,tiktok
# yt-dlp 代理。国内访问 YouTube 需要,例如 http://127.0.0.1:7890
YTDLP_PROXY=
# 浏览器导出的 cookies.txt 路径(Netscape 格式),也可以填文件夹(B 站、YouTube 各放一份)。
# B 站高清 / YouTube / 抖音下载需要。含账号登录凭证,cookies/ 已被 git 忽略
YTDLP_COOKIES=
# 素材池:按车型预先攒素材、切段、打标签,解说轨的背景画面都从这里取(见 README)
USE_LIBRARY=1
# 素材池一次构建的时长预算(秒),0 不限
LIBRARY_BUILD_BUDGET=1800
