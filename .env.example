# 复制为 .env 后填写。.env 已被 .gitignore 排除,不要提交。

# --- LLM ---
# DeepSeek API Key(脚本生成与提示词编译使用)。留空则平台无法生成脚本。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- ffmpeg ---
# 本机 ffmpeg 不在系统 PATH,默认指向已安装位置;若换机器请修改。
FFMPEG_BIN=C:\ffmpeg\bin
FFMPEG_FONTS_DIR=C:\Windows\Fonts

# --- 生成通道 ---
# mcode-tools CLI 路径(MiniMax Code 运行时注入)。留空则从 PATH 查找。
MCODE_TOOLS=

# --- 并发与配额 ---
# 视频生成并发路数上限(受一致性链约束,实际并行度可能更低)
GEN_MAX_CONCURRENCY=8
# 单镜头重试上限
MAX_RETRY_DRAFT=2
MAX_RETRY_FINAL=2
# 项目级配额节流上限(等效美元值,仅用于估算与节流,非真实账单)
DEFAULT_QUOTA_BUDGET=40
# 用户套餐到期日(用于设置页提醒)
PLAN_EXPIRES_ON=2026-10-31

# --- 品类与模型 ---
DEFAULT_CATEGORY=auto
DRAFT_MODEL=MiniMax-Hailuo-2.3
FINAL_MODEL=MiniMax-H3
FINAL_RESOLUTION=768P
