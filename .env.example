# 复制为 .env 后填写。.env 已被 .gitignore 排除,不要提交。

# --- LLM ---
# DeepSeek API Key(事实抽取、脚本与逐拍版式使用)。留空则平台无法生成脚本。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- ffmpeg ---
# 本机 ffmpeg 不在系统 PATH,默认指向已安装位置;若换机器请修改。
FFMPEG_BIN=C:\ffmpeg\bin
FFMPEG_FONTS_DIR=C:\Windows\Fonts

# --- 生成通道 ---
# 两种后端二选一:
#  - mcode : 经 MiniMax Code 托管的 mcode-tools CLI(只能在 MiniMax Code 里跑)
#  - direct: 用 M Plan 订阅 Key 直连 MiniMax 开放平台,任何终端都能跑
# 留空自动选择:配了 MINIMAX_PLAN_KEY 且找不到 mcode-tools 时走 direct。
CONNECTOR_BACKEND=
# mcode-tools CLI 路径(MiniMax Code 运行时注入)。留空则从 PATH 查找。
MCODE_TOOLS=
# M Plan 订阅 Key(sk-cp-…),在 https://platform.minimax.cn/console/plan 复制。不要提交。
MINIMAX_PLAN_KEY=
MINIMAX_API_HOST=https://api.minimax.cn
# 直连后端用的模型
TTS_MODEL=speech-2.8-hd
MUSIC_MODEL=music-2.6
IMAGE_MODEL=image-01

# --- 配额 ---
# 项目级配额节流上限(等效美元值,仅用于估算与节流,非真实账单)
DEFAULT_QUOTA_BUDGET=40
# 用户套餐到期日(用于设置页提醒)
PLAN_EXPIRES_ON=2026-10-31

# --- 并发 ---
# 同时推进几个项目(后台调度器的 worker 数)。同一项目永远只有一个写入者。
#
# 内存是硬约束:峰值 Chrome 进程数 ≈ 本值 × MOTION_WORKERS(每个约 256MB),
# 磁盘也会被成倍放大(每渲一拍拍就多几十 MB)。机器内存吃紧就保持 1,
# 确认有余量再往上调。
PIPELINE_CONCURRENCY=1
# data/ 体积超过这个值就在首页提示(字节)。默认 10 GB。
DATA_SIZE_WARN_BYTES=10737418240

# --- 品类 ---
DEFAULT_CATEGORY=auto_long

# --- 素材池 ---
# 视频平台,按优先级。可选 bilibili,youtube,douyin,tiktok(douyin 靠 Bing 站内检索,实测搜不到,默认不开)
# tiktok 主要拉品牌官方号主页(名单在 profiles/auto_long.yaml),国内需要下面的 YTDLP_PROXY
MEDIA_PLATFORMS=bilibili,youtube,tiktok
# yt-dlp 代理。国内访问 YouTube 需要,例如 http://127.0.0.1:7890
YTDLP_PROXY=
# 浏览器导出的 cookies.txt 路径(Netscape 格式),也可以填文件夹(B 站、YouTube 各放一份)。
# B 站高清 / YouTube / 抖音下载需要。含账号登录凭证,cookies/ 已被 git 忽略
YTDLP_COOKIES=
# 素材池:按车型预先攒素材、切段、打标签,解说轨的背景画面都从这里取(见 README)
USE_LIBRARY=1
# 素材池一次构建的时长预算(秒),0 不限
LIBRARY_BUILD_BUDGET=1800

# --- 分发(多平台发布 + 数据监控) ---
# 分发总开关。关掉后发布与监控都不跑,成片主链路不受影响。
PUBLISH_ENABLED=1
# 跨账号并发度。**同一账号永远串行** —— 单账号高频上传会触发平台风控。
PUBLISH_CONCURRENCY=2
# 同账号两次发布之间的随机间隔(秒),避免被判机器批量
PUBLISH_MIN_INTERVAL=30
PUBLISH_MAX_INTERVAL=90
# 平台数据监控
METRICS_ENABLED=1
METRICS_INTERVAL_MIN=30

# --- 分发:应用级密钥 ---
# 这些是**开发者资产**,不随账号变,放 .env。用户的 cookie / token 由界面上的
# 「分发台 → 添加账号」写入 data/accounts.json(已被 git 忽略)。
# 抖音开放平台:https://open.douyin.com 需要企业资质并申请 video.create / video.data 能力
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
# YouTube:Google Cloud 的 OAuth 客户端(需要能访问 YouTube Data API v3)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- 浏览器自动化(小红书 / 视频号 / 抖音网页版兜底) ---
# 留空则复用本机已装的 Chrome / Edge(与概念动画渲染用的是同一个查找逻辑)。
# 只需要 pip install playwright,不必 playwright install 再下一份浏览器。
BROWSER_PATH=
# 1 = 无头跑(正常发布);登录扫码那一次会自动开有头浏览器
BROWSER_HEADLESS=1

# --- 抓取兜底:接口 / 网页直连被拒时改用浏览器再抓一次 ---
# 0 = 关掉。遇到验证码不会自动破解,只记到 data/_browser/blocked.json,
# 用 `python scripts/browser_unblock.py` 打开有头浏览器手动过一次,登录态会保存复用。
BROWSER_FETCH=1
# 只对这些站点兜底(逗号分隔,按域名后缀匹配,如 autohome.com.cn,dongchedi.com);留空 = 全部
BROWSER_FETCH_HOSTS=
# 默认跟随 BROWSER_HEADLESS
BROWSER_FETCH_HEADLESS=1
