# 复制为 .env 后填写。.env 已被 .gitignore 排除,不要提交。

# --- LLM ---
# DeepSeek API Key(脚本生成与提示词编译使用)。留空则平台无法生成脚本。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- ffmpeg ---
# 本机 ffmpeg 不在系统 PATH,默认指向已安装位置;若换机器请修改。
FFMPEG_BIN=C:\ffmpeg\bin
FFMPEG_FONTS_DIR=C:\Windows\Fonts

# --- 生成通道 ---
# mcode-tools CLI 路径(MiniMax Code 运行时注入)。留空则从 PATH 查找。
MCODE_TOOLS=

# --- 并发与配额 ---
# 视频生成并发路数上限(受一致性链约束,实际并行度可能更低)
GEN_MAX_CONCURRENCY=8
# 单镜头重试上限
MAX_RETRY_DRAFT=2
MAX_RETRY_FINAL=2
# 项目级配额节流上限(等效美元值,仅用于估算与节流,非真实账单)
DEFAULT_QUOTA_BUDGET=40
# 用户套餐到期日(用于设置页提醒)
PLAN_EXPIRES_ON=2026-10-31

# --- 品类与模型 ---
DEFAULT_CATEGORY=auto
DRAFT_MODEL=MiniMax-Hailuo-2.3
FINAL_MODEL=MiniMax-H3
FINAL_RESOLUTION=768P

# --- 真实素材 ---
# 是否用网上抓来的真实素材替换镜头(0 = 全部走 AI 生成)
USE_REAL_CLIPS=1
# 每个项目最多多少个镜头用真实素材(0 = 不限,能用真实就用真实)
REAL_CLIP_LIMIT=0
# 视频平台,按优先级。可选 bilibili,youtube,douyin(douyin 为实验性)
MEDIA_PLATFORMS=bilibili,youtube,douyin
# yt-dlp 代理。国内访问 YouTube 需要,例如 http://127.0.0.1:7890
YTDLP_PROXY=
# 浏览器导出的 cookies.txt 路径(Netscape 格式)。B 站高清 / 抖音下载需要
YTDLP_COOKIES=
# 免费图库(非车画面兜底)。免费申请:https://www.pexels.com/api/ 、https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Coverr(视频)https://coverr.co/developers 、Unsplash(图片)https://unsplash.com/developers
COVERR_API_KEY=
UNSPLASH_ACCESS_KEY=
# 取材总时长预算(秒),超出后剩余镜头走 AI 生成
MEDIA_TIME_BUDGET=900
# 允许把真实图片做成推拉动效镜头
USE_STILL_SHOTS=1
